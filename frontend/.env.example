# Frontend environment variables (copy to .env for local use).
# NOTE: Vite inlines these at BUILD time. On Render set them as env vars on
# the Static Site BEFORE building, and rebuild after any change.

# URL of the backend (Socket.io + REST API). Same value for both vars.
# Local:      http://localhost:3000
# Production: https://metameet-backend.onrender.com
VITE_SOCKET_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# --- Optional: TURN server for WebRTC across strict NATs / mobile networks ---
# Without TURN, video calls fall back to STUN-only and may fail for some users.
# A comma-separated list of turn:/turns: URLs is supported.
# Example using a free provider (Metered OpenRelay — sign up for credentials):
# VITE_TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
