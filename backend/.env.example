# Backend environment variables (copy to .env for local use)

# Port the server listens on. Render injects PORT automatically — do NOT
# hardcode it there. Locally defaults to 3000 if unset.
PORT=3000

# Allowed CORS origin(s) for the frontend. Comma-separated for multiple.
# Leave as "*" for local dev. In production set this to your deployed
# frontend URL, e.g. https://metameet-frontend.onrender.com
CLIENT_ORIGIN=*
